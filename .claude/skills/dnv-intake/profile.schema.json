{
  "schema_version": "1.0",
  "archetype": "autonomo_contractor + conyuge",
  "note": "Канонический namespace профиля кейса. Должен быть НАДмножеством profile_key реестра форм (engine/scripts/check_namespace.py проверяет registry ⊆ schema). domain ссылается на controlled_vocabularies реестра. branch: both|initial|renovacion|family|tie — когда поле спрашивается (tie = не при сборе контекста, а на этапе TIE после одобрения). derived=true — вычисляется/ищется, не спрашивается напрямую. Отдельный класс ключей — СОСТОЯНИЕ кейса (case.*): на них ссылается applies_when в реестре форм, то есть они решают, применяется ли форма на текущем этапе. Пустой case.resolution_notified = резолюции ещё нет = формы этапа TIE не применяются.",
  "controlled_vocabularies": {
    "sexo": ["Hombre", "Mujer"],
    "estado_civil": ["Soltero/a", "Casado/a", "Viudo/a", "Divorciado/a", "Separado/a"],
    "tipo_solicitud": ["INICIAL", "RENOVADA"],
    "parentesco": ["Cónyuge", "Pareja", "Hijo/a", "Ascendiente"],
    "process_type": ["initial", "renovacion"]
  },
  "properties": {
    "case.process_type": {"type": "enum", "domain": "process_type", "required": true, "branch": "both", "label": "Первичная подача или продление?"},
    "case.archetype_ok": {"type": "bool", "required": true, "branch": "both", "label": "Кейс подходит под архетип v1 (autónomo/контрактор; cónyuge опционально)?"},
    "case.resolution_notified": {"type": "date", "required": false, "branch": "tie", "label": "Дата уведомления о резолюции (заполняется на этапе TIE после одобрения). ГЕЙТ ЭТАПА: пока пусто — формы EX-17 / EX-17-familiar / tasa-790-012 / tasa-790-012-familiar в реестре не применяются (applies_when), и field_qa.py не требует их обязательные поля."},

    "applicant.first_name": {"type": "text", "required": true, "branch": "both", "label": "Имя (как в паспорте)"},
    "applicant.last_name": {"type": "text", "required": true, "branch": "both", "label": "Первая фамилия"},
    "applicant.second_last_name": {"type": "text", "required": false, "branch": "both", "label": "Вторая фамилия (если есть)"},
    "applicant.full_name": {"type": "text", "required": false, "derived": true, "branch": "both", "label": "ФИО (из имени+фамилий)"},
    "applicant.sexo": {"type": "enum", "domain": "sexo", "required": true, "branch": "both", "label": "Пол (Hombre/Mujer)"},
    "applicant.birth_date": {"type": "date", "required": true, "branch": "both", "label": "Дата рождения"},
    "applicant.birth_place": {"type": "text", "required": true, "branch": "both", "label": "Место рождения"},
    "applicant.birth_country": {"type": "text", "required": true, "branch": "both", "label": "Страна рождения"},
    "applicant.nationality": {"type": "text", "required": true, "branch": "both", "label": "Гражданство"},
    "applicant.marital_status": {"type": "enum", "domain": "estado_civil", "required": true, "branch": "both", "label": "Семейное положение"},
    "applicant.nie": {"type": "text", "required": false, "branch": "both", "label": "NIE (обязателен при renovación; на первичной подаче может ОТСУТСТВОВАТЬ — требования предъявить его норма не ставит, тогда подаёт представитель со своей подписью: art. 5 Ley 39/2015)"},
    "applicant.files_via_representative": {"type": "text", "required": false, "branch": "both", "label": "Кто подаёт, если нет certificado digital: представитель + чем оформлено (нотариальная/консульская доверенность, простая доверенность в комплекте, REA)"},
    "applicant.passport_number": {"type": "text", "required": true, "branch": "both", "label": "Номер паспорта"},
    "applicant.passport_expiry": {"type": "date", "required": true, "branch": "both", "label": "Паспорт действителен до"},
    "applicant.address_full": {"type": "text", "required": true, "branch": "both", "label": "Домициль в Испании (как в padrón)"},
    "applicant.email": {"type": "text", "required": true, "branch": "both", "label": "Email для уведомлений"},
    "applicant.phone": {"type": "text", "required": false, "branch": "both", "label": "Телефон"},
    "applicant.permit_type": {"type": "text", "required": true, "branch": "both", "label": "Тип разрешения (teletrabajador internacional)"},
    "applicant.tipo_solicitud": {"type": "enum", "domain": "tipo_solicitud", "required": true, "derived": true, "branch": "both", "label": "INICIAL/RENOVADA (из process_type)"},
    "applicant.tie_expiry": {"type": "date", "required": false, "branch": "renovacion", "label": "Дата истечения TIE (для продления)"},
    "applicant.first_approval_date": {"type": "date", "required": false, "branch": "renovacion", "label": "Дата первичного одобрения"},
    "applicant.certificado_digital": {"type": "bool", "required": true, "branch": "both", "label": "Есть certificado digital?"},

    "applicant.qualification_basis": {"type": "text", "required": true, "branch": "both", "label": "Квалификация — ОСНОВАНИЕ по art. 74 bis: диплом вуза/высшей школы, профессиональная квалификация ИЛИ ≥3 лет профильного опыта. Записать, чем именно закрываете и каким документом (диплом+апостиль / CV+рекомендательные письма)"},
    "applicant.seguro_enfermedad": {"type": "text", "required": true, "branch": "both", "label": "Медстраховка по art. 62.3.e — какая: испанская частная (полное покрытие, без копейов и периодов ожидания) ИЛИ покрытие через котизацию в Seguridad Social. Разбор — norms/documentacion-y-forma.md"},
    "applicant.countries_last_2y": {"type": "text", "required": true, "branch": "both", "label": "Страны проживания за последние 2 года — ЧЕРЕЗ ЗАПЯТУЮ, одной строкой (не списком). По art. 62.3.c справка о несудимости нужна из каждой. Внимание: 2 года — это про справки; declaración responsable об отсутствии судимостей охватывает 5 лет, это РАЗНЫЕ документы"},

    "applicant.entry_date": {"type": "date", "required": false, "branch": "initial", "label": "Дата въезда в Испанию/Шенген (если уже въехали) — от неё считается окно законного пребывания"},
    "applicant.entry_stamp": {"type": "text", "required": false, "branch": "initial", "label": "Штамп о въезде: есть/нет и где (паспорт, какая граница). Нет штампа при въезде из другой шенгенской страны — обычная ситуация, тогда нужна declaración de entrada"},
    "applicant.declaracion_entrada": {"type": "text", "required": false, "branch": "initial", "label": "Declaración de entrada (art. 12 LOEX): подана/нет, дата и где. Требуется при въезде через другое государство Шенгена без штампа"},

    "applicant.father_name": {"type": "text", "required": false, "branch": "tie", "label": "Имя отца (поле EX-17)"},
    "applicant.mother_name": {"type": "text", "required": false, "branch": "tie", "label": "Имя матери (поле EX-17)"},
    "applicant.comisaria_provincia": {"type": "text", "required": false, "branch": "tie", "label": "Провинция/отделение, куда подаётся EX-17 (DIRIGIDA A)"},

    "work.company_name": {"type": "text", "required": true, "branch": "both", "label": "Работодатель/заказчик"},
    "work.company_country": {"type": "text", "required": true, "branch": "both", "label": "Страна регистрации компании"},
    "work.contract_type": {"type": "text", "required": true, "branch": "both", "label": "Тип отношений (contractor/трудовой)"},
    "work.contract_number": {"type": "text", "required": false, "branch": "both", "label": "Номер контракта"},
    "work.contract_date": {"type": "date", "required": false, "branch": "both", "label": "Дата контракта"},
    "work.role": {"type": "text", "required": true, "branch": "both", "label": "Должность/роль"},
    "work.income_amount": {"type": "number", "required": true, "branch": "both", "label": "Ежемесячный доход (сумма)"},
    "work.income_currency": {"type": "text", "required": true, "branch": "both", "label": "Валюта дохода"},
    "work.income_eur_equiv": {"type": "number", "required": false, "branch": "both", "label": "EUR-эквивалент дохода"},
    "work.bank": {"type": "text", "required": false, "branch": "both", "label": "Банк получения дохода"},
    "work.num_clients": {"type": "number", "required": false, "branch": "both", "label": "Число клиентов/заказчиков"},

    "family.present": {"type": "bool", "required": true, "branch": "both", "label": "Подаётся ли член семьи?"},
    "family.first_name": {"type": "text", "required": false, "branch": "family", "label": "Имя члена семьи"},
    "family.last_name": {"type": "text", "required": false, "branch": "family", "label": "Фамилия члена семьи"},
    "family.full_name": {"type": "text", "required": false, "derived": true, "branch": "family", "label": "ФИО члена семьи (из имени+фамилии). ВЫВОДИТСЯ так же, как applicant.full_name — второй фамилии члена семьи в схеме нет, и выдумывать её нельзя. Нужно для бланков tasa: плательщик там — сам заявитель, а не титуляр"},
    "family.sexo": {"type": "enum", "domain": "sexo", "required": false, "branch": "family", "label": "Пол члена семьи"},
    "family.birth_date": {"type": "date", "required": false, "branch": "family", "label": "Дата рождения члена семьи"},
    "family.nationality": {"type": "text", "required": false, "branch": "family", "label": "Гражданство члена семьи"},
    "family.nie": {"type": "text", "required": false, "branch": "family", "label": "NIE члена семьи"},
    "family.passport_number": {"type": "text", "required": false, "branch": "family", "label": "Паспорт члена семьи"},
    "family.relationship": {"type": "enum", "domain": "parentesco", "required": false, "branch": "family", "label": "Степень родства"},
    "family.tipo_solicitud": {"type": "enum", "domain": "tipo_solicitud", "required": false, "derived": true, "branch": "family", "label": "INICIAL/RENOVADA члена семьи"},
    "family.marriage_date": {"type": "date", "required": false, "branch": "family", "label": "Дата регистрации брака (если cónyuge)"},
    "family.marriage_place": {"type": "text", "required": false, "branch": "family", "label": "Место регистрации брака"},
    "family.titular_regage": {"type": "text", "required": false, "branch": "family", "label": "REGAGE titular (вписать ПОСЛЕ подачи; не выдумывать)"},
    "family.birth_place": {"type": "text", "required": false, "branch": "family", "label": "Место рождения члена семьи"},
    "family.birth_country": {"type": "text", "required": false, "branch": "family", "label": "Страна рождения члена семьи"},
    "family.marital_status": {"type": "enum", "domain": "estado_civil", "required": false, "branch": "family", "label": "Семейное положение члена семьи"},
    "family.address_full": {"type": "text", "required": false, "branch": "family", "label": "Домициль члена семьи в Испании"},
    "family.passport_expiry": {"type": "date", "required": false, "branch": "family", "label": "Паспорт члена семьи действителен до"},
    "family.email": {"type": "text", "required": false, "branch": "family", "label": "Email члена семьи"},
    "family.phone": {"type": "text", "required": false, "branch": "family", "label": "Телефон члена семьи"},
    "family.seguro_enfermedad": {"type": "text", "required": false, "branch": "family", "label": "Медстраховка члена семьи — art. 62.4 распространяет требования 62.3 и на него. СВОЙ полис: покрытие титуляра через котизацию на cónyuge не переносится"},
    "family.countries_last_2y": {"type": "text", "required": false, "branch": "family", "label": "Страны проживания члена семьи за 2 года — через запятую. Справки о несудимости нужны свои, из его стран (могут отличаться от стран титуляра)"},
    "family.father_name": {"type": "text", "required": false, "branch": "tie", "label": "Имя отца члена семьи (поле EX-17)"},
    "family.mother_name": {"type": "text", "required": false, "branch": "tie", "label": "Имя матери члена семьи (поле EX-17)"},

    "tasa.epigrafe_038": {"type": "text", "required": false, "derived": true, "branch": "both", "label": "Эпиграф tasa 790-038 — авторизация через UGE-CE (проверить вживую)"},
    "tasa.importe_038": {"type": "number", "required": false, "derived": true, "branch": "both", "label": "Сумма tasa 790-038 (проверить вживую)"},
    "tasa.epigrafe_012": {"type": "text", "required": false, "derived": true, "branch": "tie", "label": "Эпиграф tasa 790-012 (renovación и primera concesión — РАЗНЫЕ строки; проверить вживую)"},
    "tasa.importe_012": {"type": "number", "required": false, "derived": true, "branch": "tie", "label": "Сумма tasa 790-012/TIE (проверить вживую)"}
  }
}
