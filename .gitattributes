# Normalize line endings to LF in the repo so scripts and the git hook run
# correctly on Linux/macOS CI and clones, regardless of the author's OS.
* text=auto eol=lf

*.py   text eol=lf
*.sh   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.txt  text eol=lf

# Treat known binaries as binary (defensive; these are also gitignored).
*.pdf  binary
*.zip  binary
*.docx binary
*.png  binary
*.jpg  binary
