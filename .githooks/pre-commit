#!/bin/sh
# ============================================================================
#  Pre-commit PII gate — blocks committing personal data (see CONTRIBUTING.md).
#
#  Install once per clone:   git config core.hooksPath .githooks
#  (Git hooks live outside the tree and cannot be shipped directly, so this
#   tracked script is opted into with one config command.)
#
#  Runs the fast, fork-friendly profile: tracked-tree structural sweep +
#  denylist matching IF the private denylist is present. It does NOT enforce
#  the maintainer-only template-identity / require-denylist rules (CI does that
#  on the canonical repo) so contributors are not blocked by their own git
#  identity or the absence of the gitignored denylist.
# ============================================================================

# Find a Python 3 interpreter (override with PYTHON=... if yours is named oddly).
PY="${PYTHON:-}"
if [ -z "$PY" ]; then
  for cand in python3 python py; do
    if command -v "$cand" >/dev/null 2>&1; then PY="$cand"; break; fi
  done
fi

if [ -z "$PY" ]; then
  echo "pii-gate: no Python interpreter found on PATH (set PYTHON=... to override)." >&2
  echo "pii-gate: refusing the commit without running the scan (fail-closed)." >&2
  exit 1
fi

# The 'py' launcher needs an explicit -3.
if [ "$PY" = "py" ]; then
  set -- -3 engine/scripts/pii_scan.py
else
  set -- engine/scripts/pii_scan.py
fi

"$PY" "$@" --tree-only --allow-any-identity
status=$?
if [ "$status" -ne 0 ]; then
  echo "" >&2
  echo "pii-gate: commit blocked — potential personal data in the staged tree." >&2
  echo "pii-gate: fix the referenced locations (values are not printed on purpose)." >&2
  echo "pii-gate: never edit .gitignore or the denylist to sneak data past this gate." >&2
fi
exit "$status"
